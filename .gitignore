# ========================================
# NOTAS Y DOCUMENTACIÓN LOCAL
# ========================================

# Notas personales que no deben versionarse
NOTES.md
TODO.md
local-notes/
*.scratch

# ========================================
# ARCHIVOS ESPECÍFICOS A IGNORAR
# ========================================

# No ignorar esto (build.xml es necesario)
!build.xml

# No ignorar esto (lib/ tiene dependencias)
!lib/
# git no re-incluye los .jar por la regla *.jar de arriba: excepcion explicita
!lib/*.jar

# No ignorar manifests de proyecto (pero sí los generados)
!manifest.txt

# No ignorar scripts de build
!build.bat
